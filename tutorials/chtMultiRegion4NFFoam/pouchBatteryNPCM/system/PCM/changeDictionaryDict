dictionaryReplacement
{
    U
    {
        internalField   uniform (1.0e-8 0 0);
        boundaryField
        {
            top
            {
                type            fixedValue;
                value           uniform (0 0 0);
            }

            bottom
            {
                type            fixedValue;
                value           uniform (0 0 0);
            }

            left
            {
                type            fixedValue;
                value           uniform (0 0 0);
            }

            right
            {
                type            fixedValue;
                value           uniform (0 0 0);
            }

            back
            {
                type            fixedValue;
                value           uniform (0 0 0);
            }

            front
            {
                type            fixedValue;
                value           uniform (0 0 0);
            }

            PCM_to_LIB
            {
                type            fixedValue;
                value           uniform (0 0 0);
            }
        }
    }

    T
    {
        internalField   uniform 300;
        boundaryField
        {
            top
            {
                type            zeroGradient;
            }

            bottom
            {
                type            zeroGradient;
            }

            left
            {
                type            zeroGradient;
            }

            right
            {
                type            zeroGradient;
            }

            back
            {
                type            zeroGradient;
            }

            front
            {
                type            zeroGradient;
            }

            PCM_to_LIB
            {
                type            solidWallMixedTemperatureCoupled;
                neighbourRegionName LIB;
                neighbourPatchName LIB_to_PCM;
                neighbourFieldName T;
                Kappa           kappaEff;
                value           uniform 300;
            }
        }
    }

    p
    {
        internalField   uniform 0;

        boundaryField
        {
            top
            {
                type            buoyantPressure;
                rho             rhok;
                value           uniform 0;
            }

