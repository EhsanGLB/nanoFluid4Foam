            {
                type            buoyantPressure;
                rho             rhok;
                value           uniform 0;
            }
        }
    }

    alpha_MWCNT
    {
        internalField   uniform 0.03;
        boundaryField
        {
            top
            {
                type            zeroGradient;
            }

            bottom
